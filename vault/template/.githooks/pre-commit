#!/usr/bin/env bash
# Save as .githooks/pre-commit and run once: git config core.hooksPath .githooks
# Blocks a commit when any staged agent log fails validation. Works with bash 3.2 (macOS).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

logs=()
while IFS= read -r -d '' f; do
  case "$f" in
    agents/*/reports/archive/*) ;;
    agents/*/reports/*.md) logs+=("$f") ;;
  esac
done < <(git diff --cached --name-only -z --diff-filter=ACM -- agents)
[ "${#logs[@]}" -eq 0 ] && exit 0

if ! command -v bun >/dev/null 2>&1; then
  echo "pre-commit: bun not found on PATH, so agent logs cannot be validated; commit refused" >&2
  exit 1
fi
bun scripts/validate-logs.ts "${logs[@]}"
