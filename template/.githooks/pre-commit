#!/usr/bin/env bash
# Save as .githooks/pre-commit and run once: git config core.hooksPath .githooks
# Blocks a commit when any staged agent log fails validation.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! command -v bun >/dev/null 2>&1; then
  echo "pre-commit: bun not found; agent logs not validated" >&2
  exit 0
fi

mapfile -t logs < <(git diff --cached --name-only --diff-filter=ACM -- 'agents/*/reports/*.md')
if [ "${#logs[@]}" -gt 0 ]; then
  bun scripts/validate-logs.ts "${logs[@]}"
fi
